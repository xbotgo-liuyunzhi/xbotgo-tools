#!/usr/bin/env python3

import argparse
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(prog="xbotgo", description="XBotGo 团队命令行工具")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("commit", help="拟定 Git 提交信息并创建一次本地提交")
    args = parser.parse_args()

    tools_dir = Path(__file__).resolve().parent.parent / "share" / "xbotgo"
    sys.path.insert(0, str(tools_dir))
    if args.command == "commit":
        from xbotgo_commit import commit_current_repository

        try:
            commit_current_repository()
        except (OSError, RuntimeError, subprocess.CalledProcessError, ValueError) as error:
            print(f"xbotgo commit 提交失败：{error}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
